# ============================================
# CONFIGURACIÓN AZURE FORM RECOGNIZER
# ============================================
# Obtener estas credenciales desde Azure Portal:
# 1. Crear recurso "Azure AI Document Intelligence"
# 2. Ir a "Keys and Endpoint"
# 3. Copiar Endpoint y KEY 1

AZURE_FORM_RECOGNIZER_ENDPOINT=https://tu-recurso.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_API_KEY=tu-api-key-aqui

# ============================================
# CONFIGURACIÓN JWT
# ============================================
# Generar una clave segura con:
# openssl rand -hex 32

JWT_SECRET_KEY=tu-clave-secreta-muy-larga-y-segura-minimo-32-caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# ============================================
# CLIENTES PERMITIDOS
# ============================================
# Formato: client_name:shared_key,client2:key2
# Ejemplo: cliente1:clave_secreta_123,cliente2:otra_clave_456

ALLOWED_CLIENTS=cliente1:clave_secreta_cliente1,cliente2:clave_secreta_cliente2

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tamaño máximo de archivo en MB
MAX_FILE_SIZE_MB=10

# Tipos MIME permitidos (separados por coma)
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg,image/jpg

# ============================================
# CONFIGURACIÓN REDIS (Rate Limiting)
# ============================================
# Usar redis://redis:6379/0 cuando se usa Docker Compose
# Usar redis://localhost:6379/0 para desarrollo local

REDIS_URL=redis://redis:6379/0

# Límite de requests por ventana de tiempo
RATE_LIMIT_REQUESTS=100

# Ventana de tiempo en segundos (3600 = 1 hora)
RATE_LIMIT_WINDOW=3600

# ============================================
# CONFIGURACIÓN DE MODELOS CUSTOM
# ============================================
# Estos IDs se obtienen después de entrenar modelos en Azure
# Ver docs/AZURE_CUSTOM_MODELS.md para más información

# Modelo para títulos universitarios
CUSTOM_MODEL_TITULO=model-titulo-universitario

# Modelo para concentración de notas
CUSTOM_MODEL_NOTAS=model-concentracion-notas

# Modelo para cotizaciones AFP
CUSTOM_MODEL_AFP=model-cotizacion-afp

# ============================================
# CONFIGURACIÓN DE DESARROLLO
# ============================================
# No modificar en producción

# Puerto del servidor (solo para desarrollo local sin Docker)
PORT=8000

# Host (0.0.0.0 para aceptar conexiones externas)
HOST=0.0.0.0

# Reload automático (solo desarrollo)
RELOAD=false
